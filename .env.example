LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
COLLECTION_NAME=research_corpus

# Document agent. mock is the default and does not call a model.
# Set openai to use LLM_BASE_URL (hosted, or a local server such as http://localhost:11434/v1).
AGENT_LLM_BACKEND=mock
AGENT_MAX_STEPS=6
AGENT_MAX_REFLECTIONS=1
AGENT_WEB_SEARCH=0
